# DriftWatch Environment Variables Example

# Database Connection (PostgreSQL in production / Docker, SQLite locally)
DRIFTWATCH_DB_URL=postgresql://driftwatch:driftwatch_secure_password@localhost:5432/driftwatch

# MLflow Tracking Server URI
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# API Key for Admin, Ingestion, and Model Promotion Endpoints
DRIFTWATCH_API_KEY=driftwatch-secret-key

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=driftwatch
POSTGRES_PASSWORD=driftwatch_secure_password
POSTGRES_DB=driftwatch
